# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas — thay USER, PASSWORD và cluster của bạn
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxx.mongodb.net/simplecrm?retryWrites=true&w=majority&appName=CNM

# CORS (phân tách bằng dấu phẩy, không có khoảng trắng thừa)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
